FROM cgr.dev/chainguard/wolfi-base:latest AS base

WORKDIR /app

RUN apk add --no-cache curl freetype && \
    adduser -D -u 1000 portfolio && \
    mkdir /recordings && \
    chown portfolio:portfolio /app /recordings

COPY --from=mwader/static-ffmpeg:9.1 /ffmpeg /usr/local/bin/

USER portfolio

ENV SERVER_PORT=8080

ENTRYPOINT ["/app/portfolio", "-Xmx1024m", "-XX:+ExitOnOutOfMemoryError", "-Duser.timezone=Europe/Tallinn"]

FROM base

ARG BUILD_HASH=unknown
ARG BUILD_TIME=unknown

ENV BUILD_HASH=${BUILD_HASH} \
    BUILD_TIME=${BUILD_TIME}

COPY --chown=portfolio:portfolio build/native/nativeCompile/ ./
