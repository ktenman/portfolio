FROM ubuntu:26.04

WORKDIR /app

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends curl ffmpeg && \
    dpkg --purge --force-depends $(dpkg-query -Wf '${Package} ' 'libllvm*' mesa-libgallium) && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir /recordings && \
    chown ubuntu:ubuntu /app /recordings

USER ubuntu

ENV SERVER_PORT=8080

ENTRYPOINT ["/app/portfolio", "-Xmx1024m", "-XX:+ExitOnOutOfMemoryError", "-Duser.timezone=Europe/Tallinn"]

ARG BUILD_HASH=unknown
ARG BUILD_TIME=unknown

ENV BUILD_HASH=${BUILD_HASH} \
    BUILD_TIME=${BUILD_TIME}

COPY --chown=ubuntu:ubuntu build/native/nativeCompile/ ./
