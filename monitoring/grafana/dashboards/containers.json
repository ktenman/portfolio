{
  "uid": "containers",
  "title": "Containers",
  "tags": [
    "portfolio"
  ],
  "editable": false,
  "refresh": "1m",
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "name": "Deploys",
        "titleFormat": "Backend started",
        "expr": "changes(process_start_time_seconds{job=\"portfolio-backend\"}[1m]) > 0",
        "step": "1m"
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "container_memory_working_set_bytes{job=\"cadvisor\"}",
          "legendFormat": "{{name}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "links": [],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "thresholdsStyle": {
              "mode": "off"
            },
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Memory against its limit",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "container_memory_working_set_bytes{job=\"cadvisor\"} / (container_spec_memory_limit_bytes{job=\"cadvisor\"} > 0) * 100",
          "legendFormat": "{{name}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "links": [],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Swap",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "container_memory_swap{job=\"cadvisor\"}",
          "legendFormat": "{{name}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "links": [],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "thresholdsStyle": {
              "mode": "off"
            },
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\"}[2m]))",
          "legendFormat": "{{name}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "links": [],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "thresholdsStyle": {
              "mode": "off"
            },
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    }
  ]
}
