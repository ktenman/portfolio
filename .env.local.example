# Auth Service Configuration (https://github.com/ktenman/klite-auth)
# Get Google OAuth credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of allowed email addresses
ALLOWED_EMAILS=ktenman@gmail.com

# Redirect URI for OAuth callback
REDIRECT_URI=http://localhost

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://seaweedfs:9000
MINIO_BUCKET_NAME=portfolio-logos

# OpenRouter API Configuration (optional, for AI classification)
OPENROUTER_API_KEY=
